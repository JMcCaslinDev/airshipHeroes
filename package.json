{
  "name": "airship-skirmish",
  "version": "0.1.0",
  "description": "A 3D multiplayer airship battle game",
  "main": "src/main.js",
  "type": "module",
  "scripts": {
    "dev": "node copy-assets.cjs && vite",
    "build": "node copy-assets.cjs && vite build",
    "preview": "vite preview",
    "test": "jest --config=jest.config.cjs",
    "test:all": "jest --config=jest.config.cjs tests/unit",
    "test:physics": "jest --config=jest.config.cjs tests/unit/physics",
    "test:modes": "jest --config=jest.config.cjs tests/unit/modes",
    "test:components": "jest --config=jest.config.cjs tests/unit/components",
    "test:ui": "jest --config=jest.config.cjs tests/unit/ui",
    "test:input": "jest --config=jest.config.cjs tests/unit/input",
    "test:projectiles": "jest --config=jest.config.cjs tests/unit/projectiles",
    "test:blocks": "jest --config=jest.config.cjs tests/unit/blocks",
    "test:core": "jest --config=jest.config.cjs tests/unit/core",
    "test:watch": "jest --config=jest.config.cjs --watch",
    "server": "node server.cjs",
    "start": "npm run build && npm run server",
    "dev:all": "node copy-assets.cjs && node start.js"
  },
  "keywords": [
    "game",
    "three.js",
    "voxel",
    "airship",
    "multiplayer"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "compression": "^1.7.4",
    "dotenv": "^16.4.7",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.2",
    "three": "^0.157.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.2",
    "@babel/plugin-transform-modules-commonjs": "^7.23.3",
    "@babel/preset-env": "^7.23.2",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "vite": "^4.5.0"
  }
}
